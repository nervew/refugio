{
  "name": "refugio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.json index.html scripts/*.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "release:check": "node scripts/release-check.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
